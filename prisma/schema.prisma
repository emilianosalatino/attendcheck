// Checador de Asistencia - Schema
// Stack: SQLite via libSQL adapter (local file en dev, Turso en produccion)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // El adapter libsql se engancha en src/lib/db.ts.
  // Funciona igual con un archivo local (file:) que con Turso remoto (libsql://).
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Una sesion de clase (un dia/hora en que el maestro abre el QR)
model ClassSession {
  id        String   @id @default(cuid())
  /// Nombre visible de la clase, ej. "Calculo Diferencial - Grupo A"
  name      String
  /// Token unico que va codificado en el QR (URL ?t=<token>)
  token     String   @unique
  /// Fecha/hora en que inicia la ventana de asistencia
  startsAt  DateTime
  /// Fecha/hora en que caduca el QR (default: startsAt + durationMin)
  endsAt    DateTime
  /// Minutos de validez del QR
  durationMin Int    @default(15)
  /// Activa manualmente o solo por ventana de tiempo
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  attendances Attendance[]

  @@index([token])
  @@index([isActive])
}

/// Registro de asistencia de un alumno a una sesion
model Attendance {
  id        String   @id @default(cuid())
  sessionId String
  session   ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Matricula o numero de control del alumno
  studentId String
  /// Hash de huella del dispositivo (canvas + WebGL + UA + pantalla)
  deviceFp  String
  /// IP del cliente (para auditoria)
  ip        String?
  /// User-Agent completo (para auditoria)
  userAgent String?
  /// Momento exacto del registro
  submittedAt DateTime @default(now())
  /// Marcado como sospechoso (truco detectado)
  flagged   Boolean  @default(false)
  /// Razon de la bandera, ej. "Mismo dispositivo, distinta matricula"
  flagReason String?

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([deviceFp])
  @@index([studentId])
}
